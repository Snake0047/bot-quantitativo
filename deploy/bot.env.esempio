# Copia in /etc/bot.env sul server, con permessi 600 e proprietario root.
# Questi due valori NON vanno su GitHub e non vanno incollati in nessuna chat.
#
# TELEGRAM_TOKEN  te lo dà @BotFather quando crei il bot (/newbot)
# TELEGRAM_CHAT_ID lo ottieni scrivendo al tuo bot e poi aprendo
#                  https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TZ=Europe/Rome
